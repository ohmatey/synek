{
  "name": "synek",
  "version": "0.2.0",
  "private": true,
  "license": "LicenseRef-FSL-1.1-MIT",
  "type": "module",
  "workspaces": [".", "packages/*"],
  "scripts": {
    "setup": "tsx scripts/synek.ts",
    "dev": "vite dev",
    "dev:test": "PORT=3001 DATABASE_URL=e2e.db vite dev",
    "build": "vite build",
    "start": "tsx scripts/serve-build.ts",
    "docker:build": "docker build -t synek .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "cache:images": "tsx scripts/cache-seed-images.ts",
    "seed:e2e": "DATABASE_URL=e2e.db tsx scripts/seed.ts",
    "e2e:serve": "vite build && tsx scripts/serve-build.ts",
    "test:e2e": "playwright test",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "issue:key": "tsx scripts/issue-key.ts",
    "verify:mcp": "tsx scripts/verify-mcp-ops.ts",
    "verify:entities": "DATABASE_URL=verify-entities.db tsx scripts/verify-entities.ts",
    "verify:story": "DATABASE_URL=verify-story.db tsx scripts/verify-story.ts",
    "verify:public-story": "DATABASE_URL=verify-public-story.db tsx scripts/verify-public-story.ts",
    "verify:story-undo": "DATABASE_URL=verify-story-undo.db tsx scripts/verify-story-undo.ts",
    "verify:multi-story": "DATABASE_URL=verify-multi-story.db tsx scripts/verify-multi-story.ts",
    "verify:artifacts": "DATABASE_URL=verify-artifacts.db tsx scripts/verify-artifacts.ts",
    "verify:artifact-undo": "DATABASE_URL=verify-artifact-undo.db tsx scripts/verify-artifact-undo.ts",
    "verify:search": "DATABASE_URL=verify-search.db tsx scripts/verify-search.ts",
    "verify:theme": "DATABASE_URL=verify-theme.db tsx scripts/verify-theme.ts",
    "verify:story-theme": "DATABASE_URL=verify-story-theme.db tsx scripts/verify-story-theme.ts",
    "verify:globe": "DATABASE_URL=verify-globe.db tsx scripts/verify-globe.ts",
    "verify:seed-demo": "tsx scripts/verify-seed-demo.ts",
    "verify:telemetry": "tsx scripts/verify-telemetry.ts",
    "verify:funnel": "tsx scripts/verify-funnel.ts",
    "verify:agent": "tsx scripts/verify-agent.ts",
    "verify:ssrf": "tsx scripts/verify-ssrf.ts",
    "verify:isolation": "SYNEK_SECRETS_KEY=verify-isolation-master-key DATABASE_URL=verify-isolation.db tsx scripts/verify-isolation.ts",
    "verify:projects": "SYNEK_SECRETS_KEY=verify-projects-master-key DATABASE_URL=verify-projects.db tsx scripts/verify-projects.ts",
    "verify:projects-tools": "SYNEK_SECRETS_KEY=verify-projects-master-key DATABASE_URL=verify-projects-tools.db tsx scripts/verify-projects-tools.ts",
    "verify:projects-backfill": "tsx scripts/verify-projects-backfill.ts",
    "verify:brands": "SYNEK_SECRETS_KEY=verify-brands-master-key DATABASE_URL=verify-brands.db tsx scripts/verify-brands.ts",
    "verify:usage": "SYNEK_SECRETS_KEY=verify-usage-master-key DATABASE_URL=verify-usage.db tsx scripts/verify-usage.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
