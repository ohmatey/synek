# Strata is MCP-driven: the AI lives in YOUR client (Claude Desktop / Claude Code),
# not in this app. There is no model API key here — you connect a client to the
# MCP server and it creates/manages timelines.

# Local SQLite database file. Postgres is deferred (see CLAUDE.md → Scope).
DATABASE_URL=local.db

# Dev server port (default 3001).
PORT=3001

# Better Auth. Set a real secret in any non-local deployment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# The "API key" your MCP client sends as `Authorization: Bearer <token>`.
# Mint one with `bun run issue:key` (prints a long-lived session token), then
# paste it here (used by the stdio server) and into your client config.
STRATA_API_KEY=

# --- Connecting a client ---------------------------------------------------
# Remote (HTTP): point your client at  http://localhost:3001/api/mcp
#   with header  Authorization: Bearer <STRATA_API_KEY>
# Local (stdio): run a server the client launches, e.g. Claude Desktop config:
#   {
#     "mcpServers": {
#       "strata": {
#         "command": "tsx",
#         "args": ["/ABSOLUTE/PATH/TO/strata/src/mcp/stdio.ts"],
#         "env": { "DATABASE_URL": "/ABSOLUTE/PATH/TO/strata/local.db",
#                  "STRATA_API_KEY": "<token>" }
#       }
#     }
#   }
# Run only one primary writer at a time (the app OR the stdio server).
