# Synek is local-first and holds NO AI of its own — intelligence comes from your
# MCP client (Claude Desktop / Claude Code). These vars configure the local server.
# Fastest way to get a working .env + key + seeded canvas:  bun run setup

# Local SQLite database file. Postgres is deferred (see CLAUDE.md → Scope).
DATABASE_URL=local.db

# Dev server port.
PORT=3001

# Better Auth secret — signs sessions/tokens. A dev default is used if unset, but
# set a real one for any non-throwaway instance:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Auth base URL (must match how you reach the app).
BETTER_AUTH_URL=http://localhost:3001

# Bearer token your MCP client sends (Authorization: Bearer <token>). Create one
# in the app's "Connect an MCP client" panel or with `bun run issue:key`. Used by
# the stdio MCP server and read as ${SYNEK_API_KEY} by the Claude Code plugin.
SYNEK_API_KEY=

# Product analytics (PostHog) — OPTIONAL and OFF by default. Leave every value
# blank and nothing is ever sent (a fresh checkout stays fully local). Fill the
# keys to enable: the VITE_* pair powers the browser client (canvas/home
# engagement); the POSTHOG_* pair powers the server-side MCP tool events. Defaults
# target US cloud — set the *_HOST vars to https://eu.i.posthog.com for EU
# residency. Browser capture additionally honors the per-user opt-out in /account.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
