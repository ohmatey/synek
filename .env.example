# OpenRouter API key — the default model gateway (Core is bring-your-own-key).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model (an OpenRouter slug). Override to switch provider/model.
STRATA_MODEL=anthropic/claude-sonnet-4-6

# Story-generation model (optional). Storytelling rewards a stronger/more
# creative model than graph-building; falls back to STRATA_MODEL when unset.
# e.g. anthropic/claude-opus-4-7
STRATA_STORY_MODEL=

# OpenAI API key — used ONLY for image generation (gpt-image-1 isn't on
# OpenRouter). Chat works without it; "enrich/visualize" needs it.
OPENAI_API_KEY=

# Image-generation model (OpenAI). Defaults to gpt-image-1 when unset.
STRATA_IMAGE_MODEL=gpt-image-1

# Local SQLite database file. Postgres is deferred (see CLAUDE.md → Scope).
DATABASE_URL=local.db
