# Synek is local-first and holds NO AI of its own — intelligence comes from your
# MCP client (Claude Desktop / Claude Code). These vars configure the local server.
# Fastest way to get a working .env + key + seeded canvas:  bun run setup

# Local SQLite database file. Postgres is deferred (see CLAUDE.md → Scope).
DATABASE_URL=local.db

# Dev server port.
PORT=3001

# Better Auth secret — signs sessions/tokens. A dev default is used if unset, but
# set a real one for any non-throwaway instance:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Auth base URL (must match how you reach the app).
BETTER_AUTH_URL=http://localhost:3001

# Bearer token your MCP client sends (Authorization: Bearer <token>). Create one
# in the app's "Connect an MCP client" panel or with `bun run issue:key`. Used by
# the stdio MCP server and read as ${SYNEK_API_KEY} by the Claude Code plugin.
SYNEK_API_KEY=

# In-app agent (OpenRouter) — OPTIONAL and OFF by default. Synek's default is still
# BYO-client (the prompt dialogs only COPY a prompt). Set OPENROUTER_API_KEY and the
# same dialogs gain a "Run" that executes server-side against the same tools — the
# canvas builds itself live, no separate Claude needed. The key is SERVER-SIDE ONLY
# (never sent to the browser). SYNEK_AGENT_MODEL is the default OpenRouter model slug
# (a tool-calling-capable model; users can override per-run in the UI). The budget
# caps bound each run (you pay for runs).
OPENROUTER_API_KEY=
SYNEK_AGENT_MODEL=anthropic/claude-sonnet-4.6
SYNEK_AGENT_MAX_STEPS=12
SYNEK_AGENT_MAX_TOKENS=120000
SYNEK_AGENT_REQUEST_MAX_TOKENS=4096
SYNEK_AGENT_TIMEOUT_MS=60000

# Hosted multi-user (Phase 2). All OPTIONAL — a single-user local/self-host instance
# needs none of these.
# SYNEK_SECRETS_KEY encrypts per-user secrets at rest (each user's own OpenRouter key
# on a hosted instance). Set it like BETTER_AUTH_SECRET (openssl rand -base64 32);
# required only if users store keys server-side.
SYNEK_SECRETS_KEY=
# Transactional email via Resend — powers signup email verification + password reset.
# Blank = no email sent (login still works; verification/reset just won't deliver).
RESEND_API_KEY=
SYNEK_EMAIL_FROM=Synek <onboarding@resend.dev>
# Realscript brand adapter (P2 — NOT yet wired; src/lib/realscript/ does not exist yet).
# When built, the brand client resolves its base from this var. It is OPERATOR-SET and
# must be an https host on the adapter's allowlist (default https://app.realscript.com) —
# it must NEVER be derived from per-user/per-request input, or the server becomes an SSRF
# vector. The guard enforcing this is src/lib/net/ssrf.ts (see ADR 0002).
# REALSCRIPT_BASE_URL=https://app.realscript.com

# Product analytics (PostHog) — OPTIONAL and OFF by default. Leave every value
# blank and nothing is ever sent (a fresh checkout stays fully local). Fill the
# keys to enable: the VITE_* pair powers the browser client (canvas/home
# engagement); the POSTHOG_* pair powers the server-side MCP tool events. Defaults
# target US cloud — set the *_HOST vars to https://eu.i.posthog.com for EU
# residency. Browser capture additionally honors the per-user opt-out in /account.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Opt-IN self-hoster telemetry (LATER.3) — a SEPARATE channel from the PostHog vars
# above. Those carry YOUR own analytics to YOUR key; this one sends a single
# anonymous heartbeat per server boot to the PROJECT, so the count of active
# self-hosted installs is known. Default OFF: nothing is sent unless you set
# SYNEK_TELEMETRY to a truthy value (1/true/yes/on) AND a SYNEK_TELEMETRY_KEY is
# present (the published image bakes the project's ingest key; set it yourself if
# you build your own). Payload: { install_id (a one-way hash of BETTER_AUTH_SECRET —
# no PII), version, db_backend }. NEVER any graph content. Host defaults to US cloud.
SYNEK_TELEMETRY=
SYNEK_TELEMETRY_KEY=
SYNEK_TELEMETRY_HOST=https://us.i.posthog.com
