# Rebuilt inside the image — never ship the host's copies. `**/` is required so
# nested workspace installs (e.g. packages/ui/node_modules, which under bun are
# symlinks into the root .bun store) don't leak in as dangling links and break
# `npm install`/`npm prune` in the build stage.
**/node_modules
dist
.output
.nitro
.tanstack
.vite

# Local data + secrets must come from the mounted volume / runtime env, not the image.
*.db
*.db-shm
*.db-wal
.env
.env.local
.env.production

# Dev-only / VCS / test noise.
.git
.github
test-results
playwright-report
e2e
*.log
.DS_Store

# Docs, agent state, and editor dirs — not needed by `vite build` or at runtime.
# Excluding them shrinks the build context and stops a docs edit from busting the
# `COPY . .` layer (which would needlessly re-run `npm run build`).
docs
.sector137
.claude
.vscode
.idea
coverage
